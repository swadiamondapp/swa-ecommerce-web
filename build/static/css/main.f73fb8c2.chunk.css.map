    width: 100%;
  }
  .orText {
    font-size: 18px;
    text-align: center;
    /* line-height: 10px; */
  }
  /* .loginFormInput {
    width: 100%;
    color: #c1cbcd;
  } */

  .labelStyle {
    color: black;
    font-family: "gilroyNormal";
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: 1.25rem;
  }
  .allInputTextStyle {
    width: 100%;
    border: 1px solid lightgray;
    font-family: "Poppins";
    font-size: 14px;
    font-weight: 400;
    outline: none;
    border-radius: 5px;
    padding: 8px 10px;
  }
  .tabContent {
    /* padding: 0px 15px; */
  }
  .tabTitleOne {
    /* padding: 9px 20px; */
    padding: 12px 41px;
    font-size: 12px;
    color: #111212;
    text-align: center;
    font-family: "gilroyNormal";
    /* font-size: 1rem; */
    font-style: normal;
    font-weight: 400;
    line-height: 1.25rem;
  }
  .tabTitleTwo {
    padding: 12px 67px;
    text-align: center;
    font-size: 12px;
    color: #111212;
    text-align: center;
    font-family: "gilroyNormal";
    /* font-size: 1rem; */
    font-style: normal;
    font-weight: 400;
    line-height: 1.25rem;
  }
}
