    font-family: "gilroyNormal" !important;
  }
  .PrivacyPolicy {
    color: #01b3c5;
    font-weight: 400;
    font-size: 14px;
    font-family: "gilroyNormal" !important;
  }
  .Description p {
    font-weight: 400;
    font-size: 14px;
    line-height: 25px;
    color: #757c81;
    margin-top: 0px;
    font-family: "gilroyNormal" !important;
  }
  .Description2 {
    font-weight: 600;
    margin-bottom: 40px;
  }
  .Content {
  
  }
  .subHeading {
    color: #006e7f;
    font-weight: 600;
    font-size: 15px;
    font-family: "gilroyNormal" !important;
    padding: 10px 0px;
  }
}

