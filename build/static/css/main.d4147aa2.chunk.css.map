    display: flex;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .SubText {
    display: flex;
    font-weight: 400;
    font-size: 14px;
    font-family: "gilroyNormal" !important;
    border-bottom: 0.5px solid #e8e9ea;
    padding-bottom: 10px;
  }
  .Home {
    color: #00464d;
    font-weight: 400;
