@media (min-width: 568px) and (max-width: 767px) {
  .MobProductDetails {
    order: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 15px;
    overflow: scroll;
    scrollbar-color: transparent transparent;
  }
  .MobProductDetails2 {
    order: 1;
  }
  .ImageSmall {
    width: 100px;
    margin: 0px;
  }
  .BuyNow {
    width: 67%;
  }
}

@media (min-width: 300px) and (max-width: 567px) {
  .ProductDiscription {
    width: 350px;
  }
  .ParentHeadingD1 {
    margin-top: 110px;
  }
  .manpara {
    padding-left: 8px;
  }
  .SlideImage {
    max-width: 350px;
  }
  .MobProductDetails {
    order: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 15px;
    overflow: scroll;
    scrollbar-color: transparent transparent;
  }
  .MobProductDetails::-webkit-scrollbar {
    width: 0.5em; /* Width of the scrollbar */
  }

  .MobProductDetails::-webkit-scrollbar-thumb {
    background-color: transparent; /* Color of the thumb */
  }

  .MobProductDetails::-webkit-scrollbar-track {
